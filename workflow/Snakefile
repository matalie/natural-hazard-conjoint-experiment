"""Top-level Snakemake workflow.

This file defines shared configuration and paths only.
Implementation rules are grouped by purpose under workflow/rules/.
"""

import re

# ---------------------------------------------------------------------
# Shared configuration
# ---------------------------------------------------------------------
configfile: "config/config.yaml"

# All generated outputs are written below this directory.
ROOT = config["project"]["output_root"].rstrip("/\\").replace("\\", "/")

# Python source files are explicit rule dependencies so Snakemake reruns
# affected outputs when analysis code changes.
SRC = "src/natural_hazard_solidarity/"

CODING = config["conjoint"]["coding"]
RUNS = config["models"]["runs"]
HDI = config["analysis"]["hdi_prob"]


# ---------------------------------------------------------------------
# Shared paths
# ---------------------------------------------------------------------
DATA_DIR = f"{ROOT}/data"
MODEL_DIR = f"{ROOT}/models"
FIGURE_DIR = f"{ROOT}/figures"
TABLE_DIR = f"{ROOT}/tables"

CONJOINT = f"{DATA_DIR}/conjoint_{CODING}.parquet"
ANALYSIS = f"{DATA_DIR}/analysis_sample.parquet"
COMBINED = f"{DATA_DIR}/combined_surveys.parquet"
ASSIGNMENTS = f"{DATA_DIR}/respondent_geography.parquet"


# ---------------------------------------------------------------------
# Shared helpers
# ---------------------------------------------------------------------
def regex_keys(mapping):
    """Return a wildcard regex matching exactly the keys of a mapping."""
    if not mapping:
        return r"(?!)"
    return "(?:" + "|".join(re.escape(str(key)) for key in mapping) + ")"


# ---------------------------------------------------------------------
# Workflow implementation
# ---------------------------------------------------------------------
include: "rules/data.smk"
include: "rules/models.smk"
include: "rules/analysis.smk"


# ---------------------------------------------------------------------
# Default workflow to run all: conjoint preparation, models, and plos
# ---------------------------------------------------------------------
rule all:
    input:
        CONJOINT,
        DEFAULT_MODEL_FILES,
        REQUESTED_FIGURES,
        HYPOTHESIS_FIGURES,
        MODEL_DIAGNOSTIC_TABLES,
        ALL_MAP_FIGURES,
    default_target: True